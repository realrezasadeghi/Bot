  "components": {
    "schemas": {
      "WebhookUpdate": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {},
        "description": "Platform-defined Telegram-compatible update object (message or callback_query).",
        "example": {
          "update_id": 1,
          "message": {
            "message_id": 1,
            "from": {
              "id": 1,
              "first_name": "User"
            },
            "chat": {
              "id": 1,
              "type": "private"
            },
            "text": "/start",
            "date": 1760000000
          }
        }
      },
      "OccurrencesRequest": {
        "type": "object",
        "properties": {
          "termId": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Local calendar date (YYYY-MM-DD or YYYY/MM/DD). Persian digits are accepted.",
            "example": "2026-11-05"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "Local calendar date (YYYY-MM-DD or YYYY/MM/DD). Persian digits are accepted.",
            "example": "2026-11-05"
          },
          "reconcileAbsent": {
            "type": "boolean"
          }
        },
        "required": [
          "termId"
        ],
        "example": {
          "termId": "term-1",
          "from": "2026-11-05",
          "to": "2026-11-12",
          "reconcileAbsent": false
        }
      },
      "ScheduleNotificationsRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          }
        },
        "example": {
          "userId": "user-1"
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "description": "Returned when the database is reachable."
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "CONFLICT",
          "INVARIANT_VIOLATION",
          "UNRESOLVED_INTEGRATION_REQUIREMENT",
          "EXTERNAL_SOURCE_ERROR",
          "INTERNAL_ERROR",
          "REQUEST_ERROR",
          "UNAUTHORIZED",
          "ADMIN_DISABLED"
        ]
      },
      "WebhookSuccess": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "WebhookIgnored": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "ignored": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok",
          "ignored"
        ],
        "additionalProperties": false
      },
      "WebhookUnauthorized": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "const": "INVALID_WEBHOOK_SECRET"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      },
      "SyncResponse": {
        "type": "object",
        "properties": {
          "synchronization": {
            "$ref": "#/components/schemas/SynchronizationResult"
          },
          "termId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurrences": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerateOccurrencesResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "synchronization",
          "termId",
          "occurrences",
          "warnings",
          "complete"
        ],
        "additionalProperties": false
      },
      "SynchronizationResult": {
        "type": "object",
        "properties": {
          "syncRunId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SyncRunStatus"
          },
          "stats": {
