{
  "openapi": "3.1.0",
  "info": {
    "title": "Academic Scheduling Bot API",
    "version": "1.0.0",
    "description": "HTTP API for the academic scheduling bot. Admin routes require a bearer token; webhooks use platform secret headers.",
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current host"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health checks."
    },
    {
      "name": "Webhooks",
      "description": "Inbound platform webhooks."
    },
    {
      "name": "Admin",
      "description": "Authenticated administrative operations."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns `{ status: \"ok\" }` when the database is reachable.",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Database unreachable or unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/telegram": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "telegramWebhook",
        "summary": "Receive a Telegram update",
        "description": "Accepts a Telegram update. Returns 404 when TELEGRAM_BOT_TOKEN is not configured. When TELEGRAM_WEBHOOK_SECRET is configured, the matching secret header is required.",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "x-telegram-bot-api-secret-token",
            "schema": {
              "description": "Telegram webhook secret. Required when TELEGRAM_WEBHOOK_SECRET is configured.",
              "type": "string"
            },
            "description": "Telegram webhook secret. Required when TELEGRAM_WEBHOOK_SECRET is configured."
          },
          {
            "in": "header",
            "name": "x-webhook-secret",
            "schema": {
              "description": "Bale/generic webhook secret. Required when the platform webhook secret is configured.",
              "type": "string"
            },
            "description": "Bale/generic webhook secret. Required when the platform webhook secret is configured."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update accepted",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/WebhookSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/WebhookIgnored"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing webhook secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookUnauthorized"
                }
              }
            }
          },
          "404": {
            "description": "The platform is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/bale": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "operationId": "baleWebhook",
        "summary": "Receive a Bale update",
        "description": "Accepts a Bale update. Returns 404 when BALE_BOT_TOKEN is not configured. When BALE_WEBHOOK_SECRET is configured, the matching secret header is required.",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "x-telegram-bot-api-secret-token",
            "schema": {
              "description": "Telegram webhook secret. Required when TELEGRAM_WEBHOOK_SECRET is configured.",
              "type": "string"
            },
            "description": "Telegram webhook secret. Required when TELEGRAM_WEBHOOK_SECRET is configured."
          },
          {
            "in": "header",
            "name": "x-webhook-secret",
            "schema": {
              "description": "Bale/generic webhook secret. Required when the platform webhook secret is configured.",
              "type": "string"
            },
            "description": "Bale/generic webhook secret. Required when the platform webhook secret is configured."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update accepted",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/WebhookSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/WebhookIgnored"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing webhook secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookUnauthorized"
                }
              }
            }
          },
          "404": {
            "description": "The platform is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/sync": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "syncAcademicData",
        "summary": "Synchronize academic data",
        "description": "Fetches a university snapshot, persists it, and generates class occurrences.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Synchronization result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Snapshot validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "501": {
            "description": "Integration requirement not resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "External source error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Admin API disabled or configuration error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
