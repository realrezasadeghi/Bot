# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Defaults to false when NODE_ENV=production, true otherwise.
# LOG_PRETTY=true

# Bearer token protecting /api/admin routes. Admin routes return 503 when unset.
# ADMIN_API_TOKEN=change-me

# Database
DATABASE_URL=postgres://academic:academic@localhost:5432/academic_scheduling
DATABASE_POOL_MAX=10

# Application locale and time zone
APP_TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa-IR

# University portal source
UNIVERSITY_SOURCE_KEY=eqbal-portal
UNIVERSITY_OFFER_URL=https://portal.eqbal.ac.ir/Subsystem/Amozesh/Programming/Silabes/Offer/OfferShow/OfferShow.aspx
UNIVERSITY_TERM_CODE=14051
UNIVERSITY_VIEWSTATE_GENERATOR=AF036D42
UNIVERSITY_GRID_INFO=0;1;1;1;;;onGridLoad;1;;;
UNIVERSITY_CHK_MAIN=true
UNIVERSITY_REQUEST_TIMEOUT_MS=20000

# Required to call the live portal. Copy both values from an observed request.
# UNIVERSITY_QUERY_PARAM=
# UNIVERSITY_QUERY_R=

# Session cookie for the university portal.
# UNIVERSITY_COOKIE=

# Offline parsing: path to a normalized snapshot fixture.
# UNIVERSITY_HTML_FIXTURE_PATH=

# Messaging platforms. A platform is enabled when its token is present.
# TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SCOPE=telegram-main
# TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# BALE_BOT_TOKEN=
BALE_BOT_SCOPE=bale-main
# BALE_WEBHOOK_SECRET=
BALE_API_BASE_URL=https://api.telegraph.ai

# Worker
# WORKER_ID=
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCHEDULER_INTERVAL_MS=60000
WORKER_LOCK_TIMEOUT_MS=120000
WORKER_BATCH_SIZE=20

# Scheduling horizons and defaults
OCCURRENCE_HORIZON_DAYS=14
REMINDER_HORIZON_DAYS=7
SUMMARY_HORIZON_DAYS=2
SYNC_INTERVAL_MINUTES=60
DEFAULT_REMINDER_OFFSET_MINUTES=60
DEFAULT_DAILY_SUMMARY_TIME=08:00
DEFAULT_TIMEZONE=Asia/Tehran
EXAM_REMINDERS_ENABLED=false
EXAM_REMINDER_OFFSETS_MINUTES=1440,60
