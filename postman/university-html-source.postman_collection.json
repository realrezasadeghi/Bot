			"value": "20000",
			"type": "string",
			"description": "Request timeout in milliseconds (UNIVERSITY_REQUEST_TIMEOUT_MS)"
		}
	],
	"profile": null,
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Collection-level prerequest: log environment",
					"console.log('[University HTML Source] Running against {{offerUrl}}');",
					"console.log('[University HTML Source] Term: {{termCode}}');"
				]
			}
		}
	]
}
