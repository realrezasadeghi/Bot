{
	"name": "academic-scheduling-bot",
	"version": "0.3.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev:http": "tsx watch src/bootstrap/http.ts",
		"dev:worker": "tsx watch src/bootstrap/worker.ts",
		"build": "tsc -p tsconfig.build.json",
		"start:http": "node dist/bootstrap/http.js",
		"start:worker": "node dist/bootstrap/worker.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run tests/integration",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"university:inspect": "tsx src/cli/inspect-university.ts",
		"academic:sync": "tsx src/cli/sync-academic.ts",
		"db:migrate:runtime": "tsx src/cli/migrate.ts",
		"db:migrate:buildtime": "node dist/cli/migrate.js",
		"db:reset": "tsx src/cli/db-reset.ts"
	},
	"dependencies": {
		"cheerio": "^1.2.0",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"express": "^5.3.0",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@semantic-release/commit-analyzer": "^13.0.0",
		"@semantic-release/exec": "^7.0.0",
		"@semantic-release/git": "^11.0.0",
		"@semantic-release/github": "^10.0.0",
		"@semantic-release/npm": "^12.0.0",
		"@semantic-release/release-notes-generator": "^14.0.0",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"conventional-changelog-conventionalcommits": "^7.0.2",
		"drizzle-kit": "^0.31.11",
		"drizzle-seed": "^0.3.1",
		"pino-pretty": "^13.2.0",
		"semantic-release": "^24.0.0",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
