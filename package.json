{
  "name": "academic-scheduling-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:http": "tsx watch src/bootstrap/http.ts",
    "dev:worker": "tsx watch src/bootstrap/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:http": "node dist/bootstrap/http.js",
    "start:worker": "node dist/bootstrap/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "university:inspect": "tsx src/cli/inspect-university.ts",
    "academic:sync": "tsx src/cli/sync-academic.ts",
    "db:migrate:runtime": "tsx src/cli/migrate.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
